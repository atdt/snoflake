        COUNT = TABLE()
LINE    TEXT = INPUT :F(DONE)
NEXT    TEXT BREAK(' ') . WORD SPAN(' ') = :F(LAST)
        COUNT<WORD> = COUNT<WORD> + 1 :(NEXT)
LAST    COUNT<TEXT> = DIFFER(TEXT) COUNT<TEXT> + 1 :(LINE)
DONE    RESULT = CONVERT(COUNT, 'ARRAY')
        I = 0
PRINT   I = I + 1
        OUTPUT = RESULT<I,1> ': ' RESULT<I,2> :S(PRINT)
END