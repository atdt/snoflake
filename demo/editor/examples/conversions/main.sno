* From James F. Gimpel, "Algorithms in SNOBOL4" (1976), Ch. 2 (UPLO, ROMAN, BASE, SPELL, MDY).
-INCLUDE "UPLO.INC"
-INCLUDE "ROMAN.INC"
-INCLUDE "BASEB.INC"
-INCLUDE "BASE10.INC"
-INCLUDE "SPELL.INC"
-INCLUDE "MDY.INC"
	OUTPUT = UPLO('Algorithms In SNOBOL4!')
	OUTPUT = ROMAN(1976)
	OUTPUT = BASEB(255,16)
	OUTPUT = BASE10('FF',16)
	OUTPUT = SPELL(1976)
	OUTPUT = MDY(71,83)
END