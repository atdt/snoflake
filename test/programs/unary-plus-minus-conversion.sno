* @title Unary plus and minus convert string operands to numbers
* @expect >>>
* -5
* -2.5
* -3.25
* 7
* 4.5
* 6.125
* -4
* 5.
* <<<
        OUTPUT = -'5'
        OUTPUT = -'2.5'
        OUTPUT = -3.25
        OUTPUT = +'7'
        OUTPUT = +'4.5'
        OUTPUT = +6.125
        OUTPUT = -'5' + 1
        OUTPUT = +'4.5' + 0.5
END
