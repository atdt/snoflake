* @title Gimpel permutation functions
* @attribution James F. Gimpel, Algorithms in SNOBOL4, Chapters 12.2, 12.3, 12.5, and 12.6; Catspaw SNOBOL4+ program diskette
* @expect >>>
* ABC
* BAC
* BCA
* CBA
* CAB
* ACB
* ABC
* BCA
* CAB
* BAC
* ACB
* CBA
* ABC
* ACB
* BAC
* BCA
* CAB
* CBA
* 3,1,2
* <<<
-INCLUDE "PERM.INC"
-INCLUDE "PERMS.INC"
-INCLUDE "LPERM.INC"
-INCLUDE "IP.INC"
-INCLUDE "STRINGOU.INC"
-INCLUDE "REVERSE.INC"
	A = ARRAY(3)
	A<1> = 'A'; A<2> = 'B'; A<3> = 'C'
	PERM(A)
PLOOP	OUTPUT = STRINGOUT(A, '')
	PERM(A)                         :S(PLOOP)
	S = PERMS('ABC')
SLOOP	OUTPUT = S
	S = PERMS(S)                    :S(SLOOP)
	L = 'ABC'
LLOOP	OUTPUT = L
	L = LPERM(L)                    :S(LLOOP)
	P = ARRAY(3)
	P<1> = 2; P<2> = 3; P<3> = 1
	IP(P)
	OUTPUT = STRINGOUT(P, ',')
END
