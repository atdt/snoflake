* @title Unary OPSYN stack operations return names and values
* @attribution Griswold 1971, Appendix D, Solution 6.1
* @expect >>>
* TWO
* TWO
* ONE
* <<<
          DEFINE('PUSH(A)')
          DEFINE('POP(A)')
          DEFINE('TOP(A)')
          OPSYN('%','PUSH',1)
          OPSYN('#','POP',1)
          OPSYN('^','TOP',1)
          X = ARRAY('0:10',0)
          %X = 'ONE'
          %X = 'TWO'
          OUTPUT = ^X
          OUTPUT = #X
          OUTPUT = #X
          OUTPUT = #X :S(BAD)F(END)
BAD       OUTPUT = 'BAD'
          :(END)
PUSH      A<0> = A<0> + 1
          PUSH = .A<A<0>> :F(FRETURN)S(NRETURN)
POP       POP = A<A<0>>
          A<0> = GT(A<0>) A<0> - 1 :S(RETURN)F(FRETURN)
TOP       TOP = .A<A<0>> :(NRETURN)
END
