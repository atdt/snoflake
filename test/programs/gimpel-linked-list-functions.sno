* @title Gimpel linked-list helper functions
* @attribution James F. Gimpel, Algorithms in SNOBOL4, Chapters 5.3, 5.4, and 5.8; Catspaw SNOBOL4+ program diskette
* @expect >>>
* C
* B
* A
* head
* tail
* end
* tail
* changed
* <<<
-INCLUDE "REVL.INC"
-INCLUDE "LAST.INC"
-INCLUDE "COPYL.INC"
	L = LINK(LINK(LINK(, 'C'), 'B'), 'A')
	L = REVL(L)
RLOOP	IDENT(L)                        :S(LAST_TEST)
	OUTPUT = VALUE(L)
	L = NEXT(L)                     :(RLOOP)
LAST_TEST	L = LINK(LINK(, 'tail'), 'head')
	LAST(L) = LINK(, 'end')
	WALK = L
LLOOP	IDENT(WALK)                     :S(COPY_TEST)
	OUTPUT = VALUE(WALK)
	WALK = NEXT(WALK)               :(LLOOP)
COPY_TEST	C = COPYL(L)
	VALUE(NEXT(C)) = 'changed'
	OUTPUT = VALUE(NEXT(L))
	OUTPUT = VALUE(NEXT(C))
END
