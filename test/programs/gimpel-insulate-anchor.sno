* @title Gimpel function insulation restores anchor mode
* @attribution James F. Gimpel, Algorithms in SNOBOL4, Chapter 14.4; Catspaw SNOBOL4+ program diskette
* @expect >>>
* 1
* 0
* 1
* 1
* <<<
-INCLUDE "INSULATE.INC"
	DEFINE('SETANCHOR()')
	&ANCHOR = 1
	OUTPUT = &ANCHOR
	OUTPUT = SETANCHOR()
	OUTPUT = &ANCHOR
	&TRACE = 0
	OPSYN('DEFINE','DEFINE.')       :(END)
SETANCHOR	OUTPUT = &ANCHOR
	&ANCHOR = 1
	SETANCHOR = &ANCHOR             :(RETURN)
END
