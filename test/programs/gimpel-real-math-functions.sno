* @title Gimpel real math functions
* @attribution James F. Gimpel, Algorithms in SNOBOL4, Chapters 15.7, 15.8, 15.9, and 15.10
* @expect >>>
* 479
* 877
* 546
* 1047
* 523
* 785
* -785
* 2000
* 3000
* 1000
* 2718
* <<<
-INCLUDE "TRIG.INC"
-INCLUDE "ARC.INC"
-INCLUDE "LOG.INC"
-INCLUDE "RAISE.INC"
	OUTPUT = CONVERT(1000. * SIN(0.5),'INTEGER')
	OUTPUT = CONVERT(1000. * COS(0.5),'INTEGER')
	OUTPUT = CONVERT(1000. * TAN(0.5),'INTEGER')
	OUTPUT = CONVERT(1000. * ACOS(0.5),'INTEGER')
	OUTPUT = CONVERT(1000. * ASIN(0.5),'INTEGER')
	OUTPUT = CONVERT(1000. * ATAN(1.0),'INTEGER')
	OUTPUT = CONVERT(1000. * ATAN(-1.0),'INTEGER')
	OUTPUT = CONVERT(1000. * LOG(100.0,10.0),'INTEGER')
	OUTPUT = CONVERT(1000. * CLOG(1000.0),'INTEGER')
	OUTPUT = CONVERT(1000. * RAISE(1.0,5.0),'INTEGER')
	OUTPUT = CONVERT(1000. * EXP(1.0),'INTEGER')
END
